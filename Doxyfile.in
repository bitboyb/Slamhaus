PROJECT_NAME           = Slamhaus
PROJECT_NUMBER         = @SLAMHAUS_VERSION@
OUTPUT_DIRECTORY       = @DOXYGEN_OUTPUT_DIRECTORY@
OUTPUT_LANGUAGE        = English
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
QUIET                  = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@/sdk/slam @CMAKE_CURRENT_SOURCE_DIR@/src @CMAKE_CURRENT_SOURCE_DIR@/docs/index.md
FILE_PATTERNS          = *.hpp *.cpp
RECURSIVE              = YES
EXCLUDE                = @CMAKE_CURRENT_SOURCE_DIR@/src/wasm/runtime.js
EXTRACT_ALL            = YES
EXCLUDE_SYMBOLS        = Slam::Private::*
JAVADOC_AUTOBRIEF      = YES
GENERATE_TREEVIEW      = YES
USE_MDFILE_AS_MAINPAGE = @CMAKE_CURRENT_SOURCE_DIR@/docs/index.md
WARN_LOGFILE           = @DOXYGEN_OUTPUT_DIRECTORY@/warnings.log
