---
title: Slamhaus Dashboard
---

<div class="dashboard-container">
    <header class="main-header">
        <h1>Slamhaus Dashboard</h1>
        <div class="status-bar">
            <span>Project: <strong id="project-path">Loading...</strong></span>
            <span class="status-indicator" id="system-status">Ready</span>
        </div>
    </header>

    <main class="grid-menu">
        <div class="card action-card" onclick="app.buildProject()">
            <div class="icon">🔨</div>
            <h3>Build Site</h3>
            <p>Compile your project to static HTML.</p>
        </div>

        <a href="/theme-editor.html" class="card action-card">
            <div class="icon">🎨</div>
            <h3>Theme Editor</h3>
            <p>Visually edit your site's styles.</p>
        </a>

        <div class="card action-card" onclick="app.browseProject()">
            <div class="icon">📂</div>
            <h3>Switch Project</h3>
            <p>Select a different content directory.</p>
        </div>

        <div class="card action-card danger" onclick="app.exitSystem()">
            <div class="icon">❌</div>
            <h3>Exit</h3>
            <p>Stop the server and close the tool.</p>
        </div>
    </main>

    <div id="log-console" class="log-console">
        <div class="log-header">
            <span>Build Logs</span>
            <button onclick="app.clearLogs()">Clear</button>
        </div>
        <pre id="log-output"></pre>
    </div>
</div>

<script src="/assets/js/app.js"></script>
<link rel="stylesheet" href="/assets/css/dashboard.css">
