$page[title:"Theme Editor"]()

<link rel="stylesheet" href="/assets/css/dashboard.css">
<link rel="stylesheet" href="/assets/css/editor.css">

<div class="dashboard-container">
    <header class="main-header" style="margin-bottom: 20px;">
        <div style="display:flex; align-items:center; gap:15px;">
            <a href="/" class="button" style="text-decoration:none; color:white; font-size:20px;">&larr;</a>
            <h1>Theme Editor</h1>
        </div>
        <div style="display:flex; aliogn-items:center;">
             <button id="save-btn" style="padding: 10px 20px; background: #03dac6; border: none; font-weight: bold; cursor: pointer; border-radius:4px;">Save Theme</button>
        </div>
    </header>

    <div id="preview-container" class="preview-container">
        <iframe width="100%" height="500px" id="preview-frame" style="border:1px solid #333;" src="/preview/index.html"></iframe>
    </div>

    <div id="controls-container" class="controls-container">
        <div id="controls">
            Loading controls...
        </div>
    </div>
</div>

<script type="module">import {Init} from '/assets/js/editor.js'; if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',Init);}else{Init();}</script>
