$page[title:"Theme Editor"]()

<link rel="stylesheet" href="/tools/theme-editor/assets/editor.css">

<div id="preview-container" class="preview-container">
<iframe width="100%" height="500px" id="preview-frame" style="border:1px solid #333;" src="/preview/index.html"></iframe>
</div>

<div id="controls-container" class="controls-container">
<div style="display:flex; justify-content:space-between; align-items:center; margin-top:20px; margin-bottom:10px;">
<h2>Theme Controls</h2>
<button id="save-btn" style="padding: 10px 20px; background: #03dac6; border: none; font-weight: bold; cursor: pointer;">Save Theme</button>
</div>
<div id="controls">
Loading controls...
</div>
</div>

<script type="module">import {Init} from '/tools/theme-editor/assets/editor.js'; if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',Init);}else{Init();}</script>
